# Copy to `.env` (gitignored) and fill in. Standard library only — no install.

# The deployment to push into, and an agent key with the write scope.
REL_API=https://relationship-manager.everyai-com.workers.dev
REL_KEY=rel_...

# Optional: Composio, for live Fathom / Gmail / Google Calendar.
# Needs the accounts connected in your Composio workspace.
# COMPOSIO_API_KEY=ak_...
# COMPOSIO_DAYS=120

# Optional: Fathom directly, instead of through Composio.
# FATHOM_API_KEY=...

# Optional: where the AIOS desktop app keeps its data.
# AIOS_WORKSPACE=~/Library/Application Support/aios-desktop/ai-sales-os

# Optional: your own addresses, so you never appear as a contact.
# Falls back to packages/seed/self-addresses.json, then the AIOS settings.
# SELF_ADDRESSES=you@example.com,you@gmail.com
